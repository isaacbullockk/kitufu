# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Session signing secret — REQUIRED, min 32 random chars (openssl rand -hex 32). Auth is disabled (fail-closed) in production without it.

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Auth (local email + password) ──────────────────────────────
# kitufu.com is self-hosted, so it uses its own account system. Kimi account
# login ("Sign in with Kimi") is provisioned by Kimi only for sites hosted on
# Kimi's platform and does not transfer to self-hosted deployments.
OWNER_EMAIL=              # Register with this email to get role "admin" automatically

# ── AI Booking Pipeline ────────────────────────────────────────
# Primary provider — OpenRouter (https://openrouter.ai/keys). One key drives all
# three stages: Nemotron 3 Ultra (logistics + QA gate) and Kimi K2.5 (communications).
# Free-tier model variants (e.g. nvidia/nemotron-3-ultra-550b-a55b:free) work at zero
# cost but are rate-limited; paid credits remove the limits.
OPENROUTER_API_KEY=       # sk-or-v1-...

# Fallback provider — used only if OPENROUTER_API_KEY is not set
NVIDIA_API_KEY=           # NVIDIA NIM key from build.nvidia.com

# With neither key set, the pipeline is skipped gracefully and bookings still succeed.
BOOKING_WEBHOOK_URL=      # Optional: POST endpoint fired after QA approves a booking
