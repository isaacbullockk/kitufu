# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # OAuth App ID (create app at https://platform.kimi.ai — GLOBAL console)
APP_SECRET=               # OAuth App Secret (from the same app)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite — must be declared as ARG in Dockerfile) ──
VITE_KIMI_AUTH_URL=https://auth.kimi.ai        # GLOBAL auth server (English UI). auth.kimi.com = China (Chinese UI)
VITE_APP_ID=              # Same OAuth App ID as APP_ID above

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=https://auth.kimi.ai             # GLOBAL auth server
KIMI_OPEN_URL=https://platform.kimi.ai         # GLOBAL open platform

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── AI Booking Pipeline ────────────────────────────────────────
NVIDIA_API_KEY=           # NVIDIA NIM key from build.nvidia.com — drives Nemotron 3 Ultra (logistics + QA) and Kimi (communications)
BOOKING_WEBHOOK_URL=      # Optional: POST endpoint fired after QA approves a booking
